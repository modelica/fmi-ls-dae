<?xml version="1.0" encoding="UTF-8"?>
<fmiDAEManifest
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="../../schema/fmi3LayeredStandardDaeManifest.xsd"
  xmlns:fmi-ls="http://fmi-standard.org/fmi-ls-manifest"
  fmi-ls:fmi-ls-name="org.fmi-standard.fmi-ls-dae"
  fmi-ls:fmi-ls-version="1.0.0-alpha.2"
  fmi-ls:fmi-ls-description="Layered standard for DAE support in FMI."
>
  <EnableDAEParameter valueReference="10" />

  <AlgebraicVariables>
    <AlgebraicVariable valueReference="5" /> <!-- F -->
  </AlgebraicVariables>

  <ModelStructure>
    <!-- E = m/2*v^2 + k/2*x^2
           DAE-mode deps: x(vr=1), v(vr=3) -->
    <Output
      valueReference="8"
      dependencies="1 3"
      dependenciesKind="dependent dependent" />
    <!-- der(x) = v
           DAE-mode deps: v(vr=3) -->
    <ContinuousStateDerivative
      valueReference="2"
      dependencies="3"
      dependenciesKind="dependent" />
    <!-- der(v) = F/m
           DAE-mode deps: F(vr=5) -->
    <ContinuousStateDerivative
      valueReference="4"
      dependencies="5"
      dependenciesKind="dependent" />
    <!-- __residual0 = F + k*x
           DAE-mode deps: x(vr=1), F(vr=5) -->
    <Residual
      valueReference="9"
      dependencies="1 5"
      dependenciesKind="dependent dependent" />
    <!-- E is constant along the exact solution of the model.
         An importer can monitor it to measure the drift of the integration,
         and project the states back onto the manifold E = E(t=0).
           deps: x(vr=1), v(vr=3) -->
    <Invariant
      valueReference="8"
      dependencies="1 3"
      dependenciesKind="dependent dependent" />

  </ModelStructure>

</fmiDAEManifest>
